{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.starfall.invalid/contracts/registry/types.schema.json",
  "title": "TypeRegistry",
  "description": "Shape of contracts/registry/types.json. Types are never removed; retire them with status deprecated.",
  "type": "object",
  "required": ["registry_version", "types"],
  "properties": {
    "registry_version": { "type": "integer", "minimum": 1 },
    "types": {
      "type": "array",
      "items": { "$ref": "#/$defs/TypeEntry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "TypeEntry": {
      "type": "object",
      "required": ["name", "kind", "schema", "schema_version", "producers", "consumers", "status"],
      "properties": {
        "name": { "$ref": "../common/primitives.schema.json#/$defs/TypeName" },
        "kind": {
          "enum": ["command", "domain_event", "historical_event", "server_message", "rest", "data"]
        },
        "schema": {
          "description": "Schema path relative to contracts/.",
          "type": "string",
          "pattern": "^(commands|events/domain|events/historical|messages|api|data|history)/[A-Za-z0-9_./-]+\\.schema\\.json$"
        },
        "schema_version": { "$ref": "../common/primitives.schema.json#/$defs/SchemaVersion" },
        "producers": { "$ref": "#/$defs/Tags" },
        "consumers": { "$ref": "#/$defs/Tags" },
        "status": { "enum": ["active", "deprecated"] },
        "responses": {
          "description": "Command kinds only (spec p1-01 section 5.1a, moved into the registry by p1-02 when the third command arrived). Every message the server sends in answer to ONE command, in send order: `always` = for every adjudicated command, `accepted` = only when accepted. Broadcasts and asynchronous consequences (WORLD_SNAPSHOT, DEPOSIT_FIELD_STATE, HISTORICAL_EVENT_NOTICE) are not responses. A counter identity derived from this list must FAIL when its inputs are all zero.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "when"],
            "properties": {
              "type": { "$ref": "../common/primitives.schema.json#/$defs/TypeName" },
              "when": { "enum": ["always", "accepted"] }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Tags": {
      "type": "array",
      "items": { "enum": ["server", "history", "client", "bots"] },
      "uniqueItems": true
    }
  }
}
