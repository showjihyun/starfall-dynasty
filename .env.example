# STARFALL DYNASTY — 로컬 개발 환경 변수 (ADR-0003 §4)
#
# 실제 `.env` 는 커밋하지 않는다(.gitignore). 이 파일은 **dev 전용 값**이고 비밀이 아니다.
#   cp .env.example .env
#
# docker-compose.yml 에는 같은 값이 기본값으로 들어 있어 `.env` 없이도 뜬다.
# 이 파일은 (1) 값을 바꾸고 싶을 때, (2) 서버 프로세스에 환경 변수를 넣을 때 쓴다.

# --- PostgreSQL 컨테이너 ---
POSTGRES_USER=starfall
POSTGRES_PASSWORD=starfall_dev_only
POSTGRES_DB=starfall

# --- 호스트 포트 ---
# 이 PC 의 네이티브 postgresql-x64-16 서비스가 5432 를 점유하고 있어 15432 를 쓴다.
# 컨테이너 포트를 5432 로 노출하면 바인딩이 실패하거나, 도구가 엉뚱한 DB 에 붙어
# 디버깅 불가능한 혼란이 생긴다.
STARFALL_PG_HOST_PORT=15432
STARFALL_REDIS_HOST_PORT=16379

# --- 서버가 읽는 값 ---
# 호스트는 `localhost` 가 아니라 `127.0.0.1` 이다. Windows 에서 `localhost` 가 `::1` 로 먼저
# 풀리면 IPv4 에만 바인딩된 Docker 포트에 붙지 못하거나 지연이 생긴다.
DATABASE_URL=postgres://starfall:starfall_dev_only@127.0.0.1:15432/starfall
REDIS_URL=redis://127.0.0.1:16379/0
STARFALL_HTTP_ADDR=127.0.0.1:8080

# 로그 형식: pretty(사람이 읽는 형식, 로컬 기본) | json(수집기용)
STARFALL_LOG_FORMAT=pretty

# --- p0-02: 실시간 게이트웨이 ---
# 개발용 토큰 HMAC 비밀 (ADR-0008).
#
# 이 값은 **비밀이 아니다.** 이름이 그것을 선언한다. 개발용 토큰의 안전성은 암호학이 아니라
# "서버가 127.0.0.1 에만 바인딩된다"는 배포 경계 위에 있다(ADR-0008 §4). 그 전제가 깨지는
# 순간(LAN 노출·공유 개발 서버·스테이징) 이 토큰은 즉시 부적절해진다.
#
# 설정하지 않으면 서버는 정상 기동하고 `/ws` 만 503 {"status":"unavailable","reason":"auth_not_configured"}
# 가 된다. /healthz·/readyz·/debug/stats 는 영향받지 않는다.
#
# 토큰 만들기 (주체는 정규 소문자 UUIDv7 이어야 한다):
#   python -c "import hmac,hashlib,sys; s=sys.argv[1]; print(s+'.'+hmac.new(sys.argv[2].encode(), s.encode(), hashlib.sha256).hexdigest())" #     01a0b1c2-2c01-7a45-8b67-89abcdef0123 dev_only_not_a_secret
STARFALL_DEV_AUTH_SECRET=dev_only_not_a_secret

# 실제 1초당 tick 수. worlds.tick_hz 와 다르면 서버가 **기동을 거부한다**(I-19).
# 바꾸려면 새 월드를 만들어야 한다 — 이미 저장된 이벤트의 게임 시간 의미가 달라지기 때문이다.
STARFALL_TICK_HZ=20

# 붙을 월드. 기본값은 마이그레이션 0001 이 시드한 스파이크 월드다.
STARFALL_WORLD_ID=01a0b1c2-3d4e-7f01-8a2b-9c0d1e2f3a4b

# 선택: 로그 레벨. 없으면 info(게이트웨이는 debug).
# RUST_LOG=info,starfall_gateway=debug
