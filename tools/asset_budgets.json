    { "match": "wreck.glb", "max": { "file_mb": 13, "vertices": 23000, "drawn_triangles": 16000, "materials": 4, "texture_max_px": 2048, "texture_mb": 12 } },
    { "match": "*.glb", "max": { "file_mb": 13, "vertices": 70000, "drawn_triangles": 55000, "materials": 6, "texture_max_px": 2048, "texture_mb": 11 } }
