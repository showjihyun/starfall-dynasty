    { "match": "station.glb", "max": { "file_mb": 24, "vertices": 400000, "drawn_triangles": 350000, "materials": 6, "texture_max_px": 2048, "texture_mb": 8 } },
    { "match": "ancient_gate.glb", "max": { "file_mb": 17, "vertices": 55000, "drawn_triangles": 480000, "materials": 4, "texture_max_px": 2048, "texture_mb": 14 } },
