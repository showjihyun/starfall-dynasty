// NPC ships (pirates, scenario guardians). Read at run time (crates/shared/src/tuning.rs).
// hull, shield and damage are level-0 values; each level adds level_scale of them.
(
    level_scale: 0.35,
    weapon_range: 520.0,          // + weapon_range_per_radius × radius
    weapon_range_per_radius: 4.0,
    shield_regen: 0.05,           // share of max shield per second
    accel: 0.8,                   // share of speed
    turret_damage: 0.5,           // share of gun damage
    turret_interval: 1.1,         // seconds
    turret_range: 1.2,            // share of weapon range

    // 3D tactics (main goal "3D freedom", docs/BALANCE.md 「3D 활용도」). Leaving this block out gives
    // the old flat behaviour: dive 0, tilt 0, spin 0, spawn 300/80, wander 0.
    tactics: (
        dive_slope: 0.55,         // attack runs come in ~29° from above or below
        orbit_tilt: (35.0, 80.0), // orbit plane tilt per ship, degrees out of the ship's horizontal
        orbit_spin: 0.25,         // rad/s: the orbit plane keeps turning (corkscrew)
        spawn_xz: 300.0,
        spawn_y: 260.0,           // pirate groups spawn in a ball, not a flat slab
        wander_tilt: 0.6,
    ),

    // Free-roaming pirates in Frontier and wilder systems: up to base + per_level × pirate level
    // (Frontier 1, Wild 2, War Zone 3), a group of 1–3 every `interval` s. While a captain fights a
    // chapter's wave there, none spawn and roaming ones leave that captain alone unless shot at
    // (campaign QA: chapter 2's wave of 3 met up to 8 pirates).
    // station_leash (2026-10-25, mining QA docs/QA_CAMPAIGN.md 「채굴 루프」): roaming pirates leave captains within
    // this many u of the station (the docking approach; belts start ~900 u out) alone unless shot at. Before it a small
    // ship that ran home was killed at the dock (combat lock), 5 deaths in 5 tries in every Wild system.
    ambient: (base: 2, per_level: 2, interval: 18.0, leave_waves: true, station_leash: 500.0),

    // Deaths in a row to one chapter wave before its ships' `hint` toasts (then every that many again). 2026-10-25,
    // campaign QA docs/QA_CAMPAIGN.md: head-on Wren and Mule beat chapter 5 only near the Lv9 cap; from under the
    // belly Lv6–7 does (test losing_a_boss_wave_twice_tells_where_its_turrets_do_not_reach).
    hint_after: 2,

    // bounty: credits × (1 + level), materials as given. Economy rebalance v1 (2026-10-17): credits ×0.6.
    archetypes: {
        Raider:   (hull: 160.0,  shield: 60.0,   damage: 8.0,  fire_interval: 0.5,  speed: 95.0, turn: 1.6, radius: 9.0,  turrets: 0,
                   bounty: (credits: 54, alloy: 1)),
        Gunship:  (hull: 320.0,  shield: 140.0,  damage: 13.0, fire_interval: 0.6,  speed: 70.0, turn: 1.6, radius: 14.0, turrets: 0,
                   bounty: (credits: 120, alloy: 3, datacore: 1)),
        Warden:   (hull: 260.0,  shield: 260.0,  damage: 12.0, fire_interval: 0.45, speed: 90.0, turn: 1.6, radius: 12.0, turrets: 0,
                   bounty: (credits: 102, crystal: 3, relic: 1)),   // ancient guardians carry relics (campaign QA: Lv9 needed more than chapters give)
        // Warlord and Sentinel turn 0.7 → 0.25 rad/s (2026-10-24, main goal "3D freedom"): at 0.7 a 60 m
        // leviathan swung its nose onto a captain as fast as a fighter, so the point over its hull moved
        // hundreds of m/s and nobody could get out of its turret arcs (docs/3D_전투_설계.md 「PvE」).
        Warlord:  (hull: 1900.0, shield: 700.0,  damage: 26.0, fire_interval: 0.35, speed: 65.0, turn: 0.25, radius: 30.0, turrets: 6,
                   bounty: (credits: 1500, alloy: 20, datacore: 4, relic: 1),
                   hint: Some("칼즈 군벌은 기수를 느리게 돌립니다 — 정면을 피해 선체 바로 위나 아래에 붙으면 포탑 절반만 닿습니다 (기수 상하 키, 상승·하강 키)")),
        // Sentinel ventral_turrets 1 (2026-10-24): one battery under its belly, the other five of the ventral
        // half on the flanks — 12 reach a ship level with it, 6 one above it, 1 one under it. Halving its
        // fire from above was never enough against chapter 5 (a Lv7 cruiser took it to 70% before dying).
        // Chapter 5 from under the belly: Lv6–7 instead of Lv8; 0 under it made chapter 5 a 1.5 min fight
        // for every hull, 2 left almost no gain (docs/3D_전투_설계.md 「PvE」).
        Sentinel: (hull: 5200.0, shield: 2200.0, damage: 38.0, fire_interval: 0.3,  speed: 55.0, turn: 0.25, radius: 60.0, turrets: 12, ventral_turrets: Some(1),
                   bounty: (credits: 5400, alloy: 40, crystal: 30, datacore: 10, relic: 3),
                   hint: Some("리바이어던 센티넬의 포대는 옆구리와 등에 몰려 있고 배 아래에는 1문뿐입니다 — 배 아래로 파고들어 싸우세요 (하강 키)")),
    },
)
