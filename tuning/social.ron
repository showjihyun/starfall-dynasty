// Player contracts (crates/shared/src/contracts.rs). Read at run time.
(
    min_reward: 200,            // credits; the reward is held in escrow when posting
    max_hours: 72,              // longest deadline
    max_open: 5,                // open or running contracts one employer may have
    fulfil_reputation: 5,       // contractor, on completion
    betrayal_reputation: -30,   // whoever turns on the other party while a contract stands

    // Political influence: what alliance members do in a (non-Core) system earns their alliance influence there.
    influence_pirate: 5.0,      // per pirate destroyed
    influence_sale_unit: 0.2,   // per unit of ore sold at the station
    influence_contract: 15.0,   // per contract fulfilled there
    influence_donation: 30.0,   // per artifact donated to its museum
    control_threshold: 60.0,    // influence needed to take control…
    control_margin: 0.2,        // …and how far ahead of the current holder (20%)
    influence_decay_hourly: 0.97,
    control_bonus: 0.1,         // controlling alliance's members: +10% bounties and ore prices there
    influence_battle_win: 25.0, // an alliance winning a battle in the system…
    influence_battle_loss: 15.0,// …and each alliance on the losing side (subtracted)
    tax_rate: 0.05,             // share of non-members' ore sales and bounties there paid to the controller's treasury

    // Snowball guard.
    overreach: 0.25,            // influence gains ÷ (1 + overreach × other systems the alliance already controls)
    free_systems: 1,            // systems held without upkeep (the home base)
    upkeep_base: 150,           // hourly treasury upkeep = upkeep_base × (held − free_systems)^upkeep_exponent;
    upkeep_exponent: 1.5,       // unpaid → the weakest held system is abandoned

    // Living-war rules (2026-10-25, war QA docs/QA_WAR.md: one alliance grew 4 → 24 systems (52%) in a day with an
    // empty treasury, 152 changes of hands came mostly from out-hunting pirates, and an enemy at a home station
    // killed its captains as they rebuilt — 2354 losses in 8 h).
    foreign_gain: 0.2,          // hunting/trade/contracts/donations earn 20% in a system another alliance controls (battles full)
    system_income: 300,         // hourly treasury income per controlled system: holding pays up to ~6–7 systems
    abandon_until_paid: true,   // unpaid upkeep: weakest systems go until the rest is affordable (was one an hour)
    station_guard: (
        range: 900.0, dps: 220.0,  // controller's station batteries vs captains at war with it: the docking approach, short of the belts (~900–1200 u)
        // Siege (2026-10-26, QA_WAR: territory changed hands through hunting and upkeep, not battles).
        hp: 4000.0, siege_dps: 30.0,  // each enemy captain on the approach wears the batteries down (escorts only draw fire): one dies first, a squadron silences them
        siege_drain: 0.5, siege_gain: 1.0,  // influence/s holder → attacker while silenced and outnumbered there (captains): a 100-point hold falls in ~2 min
        rebuild_secs: 120.0, rebuild_cost: 2000,  // back online after 2 min with no enemy on the approach, paid by the holder's treasury
        fortify_cost: 3000, fortify_step: 0.5, fortify_max: 3,  // treasury sink: level k costs 3000k, ×(1 + 0.5k) dps and integrity
    ),
    conquest_purge: 0.5,        // taken from another alliance: the old holder keeps half its influence there (QA_WAR: 99 of 288 changes were retaken within the hour)
    hegemon_share: 0.3, hegemon_min: 4,  // the hegemon (≥30% of held systems, ≥4): war on it is free and breaks no truce (QA_WAR: the map froze, one lead change a day)
    rivalry_battles: 5, rivalry_bonus: 0.5,  // five battles between two alliances make rivals (RIVALRY in the chronicle); beating a rival: +50% battle influence
    war_cost: 500,              // treasury per system the declaring alliance holds (a newcomer declares for free)
    // Betrayal and rebellion (2026-11-08, QA_WAR: alliances were monoliths — the lead changed twice a day).
    betrayal: (
        defect_share: 0.6,      // leaving while docked at a held station takes 60% of the influence there: a governor's secession
        defect_hours: 1.0,      // …given to the alliance founded or joined within the hour
        truce_hours: 12.0,      // peace is a 12 h truce; a declaration inside it breaks the treaty
        breach_infamy: 1.0,     // +1 infamy to the breaker…
        infamy_war_cost: 1.0,   // …each point doubles more of its war cost (×(1 + infamy))
        infamy_decay_hourly: 0.97,  // half gone in ~a day
        coup_majority: 0.5,     // more than half of the members back a challenger → new leader
    ),

    // Player institutions (research institutes / museums). Rebalance v1 (2026-10-17): visit 20+10n → 60+30n.
    institute_cost: 5000,       // credits to found one (one per captain)
    visit_base: 60,             // founder's income per distinct visitor per day…
    visit_per_exhibit: 30,      // …plus this per exhibit on display
    exhibit_reputation: 15,     // donor, per artifact put on display
)
