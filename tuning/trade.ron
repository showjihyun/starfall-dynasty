// The open galaxy's work and trade (crates/shared/src/tuning.rs TradeTuning). Read at run time.
//   jobs:   station job boards (crates/shared/src/jobs.rs) — what each station posts, how far it sends you, what it pays.
//   market: the trade goods market (crates/shared/src/market.rs) — what each system makes and needs, prices, contraband.
//   titles: what earns each title (crates/shared/src/titles.rs).
// After an edit: cargo test --release -p shared (boards, routes, titles) and -p sim --test trade (jobs, market,
// customs, titles in the game). Unknown or missing fields are errors.
//
// Scale (2026-11-11): a Lv1 Talon's hold is 25, a mining trip ~750 CR, a daily 900–3600 CR, chapter rewards 6k–40k CR.
// A job should pay about what the same minutes mining would, more for the risk and the distance: the open galaxy
// is a second way to grow, not a shortcut past the campaign.
(
    jobs: (
        period_secs: 1800,        // a new board every half hour of game time
        per_board: 5,
        max_active: 4,
        // Weights by the posting station's tier: the core wants goods and couriers, war zones want guns.
        kinds: {
            // Smuggling is posted away from the core's customs; patrols where pirates are; salvage anywhere.
            Core:     { Haul: 4, Supply: 4, Survey: 3, Prospect: 2, Bounty: 2, Armada: 0, Smuggle: 0, Patrol: 1, Salvage: 2 },
            Frontier: { Bounty: 4, Haul: 3, Survey: 3, Prospect: 3, Supply: 2, Armada: 2, Smuggle: 2, Patrol: 3, Salvage: 2 },
            Wild:     { Bounty: 4, Armada: 3, Haul: 3, Supply: 2, Survey: 2, Prospect: 2, Smuggle: 3, Patrol: 3, Salvage: 2 },
            WarZone:  { Armada: 5, Bounty: 4, Supply: 3, Haul: 1, Survey: 1, Prospect: 1, Smuggle: 2, Patrol: 3, Salvage: 1 },
            Deep:     { Armada: 3, Bounty: 3, Survey: 2, Prospect: 2, Haul: 0, Supply: 0, Smuggle: 1, Patrol: 2, Salvage: 2 },
        },
        limit_secs: 3600,
        bounty_range: 2.6,
        // Played (sim example `career`, 2026-11-12, docs/QA_CAMPAIGN.md): a warp hop is ~4 s, not 75, so the first values paid
        // 5–10× mining. Now couriers and surveys pay about mining's rate at the same level, combat jobs 1.2–1.8× at Lv5.
        bounty: 100.0,            // × risk_reward of the target's tier × (1 + 0.35 level) × (1 + 0.25 escorts)
        names_first: ["붉은 이빨", "검은 닻", "재의", "외눈", "녹슨", "침묵의", "피의", "늙은", "유령", "굶주린", "번개", "쇠사슬"],
        names_last: ["바르크", "모로우", "실라", "드레이크", "카스", "넬", "오르벡", "제탄", "루크", "베인", "하스크", "티벨"],
        haul_range: (1.2, 4.5),
        haul_units: (8, 20),
        haul_base: 80.0, 
        haul_per_unit_ly: 4.0,    // × units × ly × risk_reward of the destination's tier
        haul_secs_base: 1200,
        haul_secs_per_ly: 900.0,
        survey_range: (2.0, 6.5),
        survey_per_system: 140.0,   // × risk_reward of that system's tier
        prospect_premium: 4.0,   // 2.2 paid 172 CR/min at Lv5 — 19 min of mining a far rare deposit (sim example `career`, 2026-11-12)
        armada: {
            Frontier: [(Raider, 5), (Gunship, 1)],
            Wild:     [(Raider, 6), (Gunship, 3)],
            WarZone:  [(Raider, 6), (Gunship, 3), (Warlord, 1)],
            Deep:     [(Raider, 6), (Gunship, 4), (Warlord, 1)],
        },
        armada_per_ship: 50.0,    // × ships × risk_reward × (1 + 0.3 level)
        armada_secs: 2400,
        supply_units: (10, 30),
        supply_premium: 1.0,
        // A bounty target's escorts and an armada's ships pay this share of a pirate's usual bounty: the
        // job's reward is the pay (sim example `career`, 2026-11-12: at full bounty the kills paid 2–3× the job).
        wave_bounty: 0.25,
        // Combat jobs come in grades, so a small ship finds a fight it can win (2026-11-12: every bounty was a
        // gunship with 1–3 escorts above the system's pirates, and a Lv1 Talon won 1 in 5). level: over the tier's pirates.
        bounty_grades: [
            (weight: 3, archetype: Raider,  level: -1, escorts: (0, 0)),   // a lone raider
            (weight: 3, archetype: Gunship, level: -1, escorts: (0, 1)),
            (weight: 2, archetype: Gunship, level: 0,  escorts: (1, 2)),
            (weight: 2, archetype: Gunship, level: 1,  escorts: (2, 3)),
        ],
        armada_scale: [(2, 0.35), (2, 0.65), (2, 1.0)],
        // A fight's threat: per ship, this × (1 + step × its level). threat_by_level: the most each ship level won 80%+ of
        // (sim example `career -- --threat`, 2026-11-12: Lv1 ≤4, Lv3 ≤7, then a jump — Lv4 ≤18 —, Lv7 7/10 above 32, Lv8 all).
        threat: { Raider: 1.0, Gunship: 2.5, Warden: 3.0, Warlord: 8.0, Sentinel: 8.0 },
        threat_level_step: 0.3,
        threat_by_level: [4.0, 5.5, 7.0, 18.0, 24.0, 28.0, 40.0, 99.0],
        // Smuggling (2026-11-12): a haul's pay × this, for the cargo core customs seize (and the fine).
        smuggle_premium: 1.3,
        // Patrol: 2–3 lawless systems near the station, a pack of raiders in each at that system's pirate level.
        patrol_systems: (2, 3),
        patrol_wave: [(Raider, 3)],
        patrol_per_system: 200.0,     // × risk_reward of the system
        // Salvage: fly to a wreck, scan its flight recorder out, hand it in.
        salvage: 120.0,
    ),

    market: (
        base: { Rations: 16.0, Medicine: 42.0, Machinery: 55.0, FuelCells: 30.0, Electronics: 78.0, Luxuries: 105.0, Arms: 90.0, Stims: 130.0 },
        // A Lv5 Mule (hold 332, 3.9 ly a warp) made 5000 CR/min at 0.75 / 1.3, depth 420, half-life 900 (sim example `career`):
        // now ~1700 (Lv1 ~285); a big hold dries a market up quickly and it comes back slowly.
        produce_price: 0.8,
        demand_price: 1.25,
        tier: { Core: 0.9, Frontier: 1.0, Wild: 1.12, WarZone: 1.25, Deep: 1.4 },
        spread: 0.05,
        depth: 250.0,             // buying a 90-unit hold raises the price ~43%
        half_life: 2400.0,
        // Industries follow the star: yellow suns feed people, red giants mine metal, blue giants and neutron stars burn hot.
        industries: {
            YellowDwarf: [Rations, Medicine, Luxuries],
            RedGiant:    [Machinery, Arms, Rations],
            BlueGiant:   [FuelCells, Electronics, Luxuries],
            WhiteDwarf:  [Electronics, Medicine, Machinery],
            Neutron:     [FuelCells, Arms, Electronics],
        },
        produce_count: 2,
        // Needs follow the risk: the core lives well, the frontier builds, the wild and the war zones fight.
        needs: {
            Core:     [Luxuries, FuelCells, Rations, Electronics],
            Frontier: [Machinery, Medicine, Rations, Stims],
            Wild:     [Medicine, Arms, Rations, Electronics],
            WarZone:  [Arms, Medicine, FuelCells, Stims],
            Deep:     [Rations, Medicine, Machinery],
        },
        demand_count: 2,
        contraband: [Stims],
        black_market: [Wild, Deep],
        seize_in: [Core],
        fine: 1.0,
        fine_reputation: 5,
    ),

    titles: {
        Tracker: 1,          // campaign chapters
        GateWalker: 5,
        BountyHunter: 5,     // bounty jobs
        PirateBane: 150,     // pirates destroyed
        Courier: 5,          // haul jobs
        Merchant: 40000,     // net credits from trade goods
        Pathfinder: 12,      // systems visited
        Cartographer: 30,
        Prospector: 3,       // prospect jobs
        Defender: 2,         // armadas broken
        Admiral: 8,
        Smuggler: 40,        // contraband units sold
        Quartermaster: 5,    // supply jobs
        Freelancer: 1,       // of every kind of job
        Legend: 10,          // other titles
    },
)
