// Ore market (crates/sim/src/game/actions.rs `price`, sim.rs mining). Read at run time.
// Price per unit = base × (tier_base + tier_step × pirate level of the system) × scarcity × (trader bonus)
// scarcity = 1 / (1 + recent supply sold here ÷ scarcity_supply); supply decays over time.
(
    // Economy rebalance v1 (2026-10-17, docs/BALANCE.md 「사회 경제」): prices 6/14/48 → 3/7/20, scarcity 250 → 120.
    // Mining loop v2 (2026-10-25, docs/QA_CAMPAIGN.md 「채굴 루프」): ×3 → 9/21/60 — a starter's hold sold for
    // ~110 CR, a third of one scan, and a Lv4→5 module took 40 min of mining; a trip now pays like a scan.
    // Xenite only ×1.5 (20 → 30): found only outside Core, at ×3 a Frontier hold paid 4× a Core one at almost no risk.
    ore_prices: { Ferrite: 9.0, Lumen: 21.0, Xenite: 30.0 },
    tier_base: 0.8,
    tier_step: 0.25,
    scarcity_supply: 120.0,
    trader_bonus: 1.2,          // Trader profession: sale price ×
    miner_bonus: 1.4,           // Miner profession: mining rate ×

    // Risk premium by system tier: scans, artifacts and battle wins…
    risk_reward: { Core: 0.6, Frontier: 1.0, Wild: 1.5, WarZone: 1.8, Deep: 2.6 },
    // …and pirate bounties (Core never pays less than Frontier for a pirate). Rebalance v1.1 (2026-10-17):
    // Wild/WarZone/Deep 1.5/1.8/2.6 → 0.95/1.15/1.6 — more and tougher pirates already pay more there;
    // Wild hunting was ~2× Wild mining, now ~1.3×.
    bounty_risk: { Core: 1.0, Frontier: 1.0, Wild: 0.95, WarZone: 1.15, Deep: 1.6 },
    // Share of a bounty paid while the killer's mining beam is on (2026-10-25, mining QA docs/QA_CAMPAIGN.md
    // 「채굴 중 현상금」, spec mining_bounty): a Lv5 cruiser parked on a Deep asteroid made 77% of its 5.6k CR/min
    // from pirates its turrets killed on their own. Stop mining to fight for the full bounty.
    mining_bounty: 0.3,

    // Seconds for ore sold at a station to weigh half as much on its price (scarcity above).
    // Was a fixed ×0.9995/s (≈ 1386 s): one captain selling a hold every few minutes held a core
    // station at ~26% of its price (campaign QA, docs/QA_CAMPAIGN.md).
    supply_half_life: 300.0,

    // Campaign chapter rewards, chapters 1–5 (shared::missions). 2026-10-24, campaign QA (docs/QA_CAMPAIGN.md):
    // chapters 1–4 doubled, then chapter 2 raised again (12000 CR/60 alloy → 20000/120) — a captain reached
    // chapter 3 with 2 alloy and ground 40 min for the upgrades to beat it; now chapter 3 takes 1–2 min and the
    // first grind is chapter 4 (chapter 3 20000 → 25000 CR to keep rewards rising). Campaign 1h35–2h38 → 1h01–1h28 (Wren aside); chapter 5 unchanged.
    // Chapter 4 materials halved (120/80/24 → 60/40/12, 2026-10-24, main goal "3D freedom"): under a leviathan's
    // belly chapter 5 takes Lv6, which chapter 4's reward alone bought — a 3D captain finished the campaign in
    // 6 min. Now 3D 15–27 min, head-on 1h17–1h30 (was 1h05–1h21; docs/QA_CAMPAIGN.md).
    chapter_rewards: [
        (credits: 6000, alloy: 40, crystal: 15, datacore: 4),
        (credits: 20000, alloy: 120, crystal: 35, datacore: 8, relic: 1),
        (credits: 25000, alloy: 90, crystal: 50, datacore: 16, relic: 2),
        (credits: 30000, alloy: 60, crystal: 40, datacore: 12, relic: 4),
        (credits: 40000, alloy: 150, crystal: 120, datacore: 30, relic: 6),
    ],
)
