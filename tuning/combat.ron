// Combat rules. Read at run time (crates/shared/src/tuning.rs).
(
    // No ship is invulnerable: this share of every hit passes through shields to the hull…
    shield_bleed: 0.1,
    // …and every hit that lands costs at least this many hull points.
    min_hull_damage: 1.0,
    // Aim cones in radians (0.11 ≈ 6.3°): player fighter guns, keeping a locked target, AI guns, bow main gun.
    laser_cone: 0.11,
    lock_cone: 0.22,
    npc_cone: 0.35,
    main_cone: 0.12,
    // Turret firing arcs (3D): batteries alternate dorsal/ventral. A dorsal battery engages targets
    // above the hull's plane plus this overlap band (0.25 ≈ 14° below it); ventral the mirror image.
    // So a ship level with you takes every battery, one straight above or below only half. 1.0 = no arcs.
    turret_arc_overlap: 0.25,
    // Roll rate as a multiple of the turn rate. A rolling defender brings an attacker above or below
    // back level with every battery; an attacker can follow only within speed ÷ roll rate (BALANCE.md).
    roll_rate: 1.3,
    // War zones (2026-10-24, main goal "epic spread-out battles"): captains and their escorts deal each
    // other this share of damage there, so a fleet war lasts minutes, not seconds (1020 captains:
    // 90% of ships sunk at 46 s → 3 min, docs/3D_전투_설계.md 「대규모 교전의 넓이」). Pirates, bosses and
    // PvP outside war zones are unchanged.
    war_pvp_damage: 0.15,
)
