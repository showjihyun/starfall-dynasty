// Combat rules. Read at run time (crates/shared/src/tuning.rs).
(
    // No ship is invulnerable: this share of every hit passes through shields to the hull…
    shield_bleed: 0.1,
    // …and every hit that lands costs at least this many hull points.
    min_hull_damage: 1.0,
    // Aim cones in radians (0.11 ≈ 6.3°): player fighter guns, keeping a locked target, AI guns, bow main gun.
    laser_cone: 0.11,
    lock_cone: 0.22,
    npc_cone: 0.35,
    main_cone: 0.12,
    // Turret firing arcs (3D): batteries alternate dorsal/ventral. A dorsal battery engages targets
    // above the hull's plane plus this overlap band (0.25 ≈ 14° below it); ventral the mirror image.
    // So a ship level with you takes every battery, one straight above or below only half. 1.0 = no arcs.
    turret_arc_overlap: 0.25,
)
