// Combat rules. Read at run time (crates/shared/src/tuning.rs).
(
    // No ship is invulnerable: this share of every hit passes through shields to the hull…
    shield_bleed: 0.1,
    // …and every hit that lands costs at least this many hull points.
    min_hull_damage: 1.0,
    // Aim cones in radians (0.11 ≈ 6.3°): player fighter guns, keeping a locked target, AI guns, bow main gun.
    laser_cone: 0.11,
    lock_cone: 0.22,
    npc_cone: 0.35,
    main_cone: 0.12,
    // Turret firing arcs (3D): batteries alternate dorsal/ventral. A dorsal battery engages targets
    // above the hull's plane plus this overlap band (0.25 ≈ 14° below it); ventral the mirror image.
    // So a ship level with you takes every battery, one straight above or below only half. 1.0 = no arcs.
    turret_arc_overlap: 0.25,
    // Roll rate as a multiple of the turn rate. A rolling defender brings an attacker above or below
    // back level with every battery; an attacker can follow only within speed ÷ roll rate (BALANCE.md).
    roll_rate: 1.3,
    // War zones (2026-10-24, main goal "epic spread-out battles"): captains and their escorts deal each
    // other this share of damage there, so a fleet war lasts minutes, not seconds (1020 captains:
    // 90% of ships sunk at 46 s → 3 min, docs/3D_전투_설계.md 「대규모 교전의 넓이」). Pirates, bosses and
    // PvP outside war zones are unchanged.
    war_pvp_damage: 0.15,
    // Flight (moved out of code 2026-10-25): boost multiplies top speed and acceleration, strafing moves at
    // this share of top speed, a warp drive charges this many seconds (a hit cancels it).
    boost: 1.7,
    strafe: 0.6,
    // Boosting takes the weapons' and shields' power (2026-10-25, spec boost_power): no gun, turret, main gun or
    // missile fires and shields do not regenerate while it is held. Boost was free, so holding it was always right.
    boost_power: true,
    // Rebuilding a sunk ship (2026-11-08, QA_WAR: fronts traded a death every few minutes all day). The first loss is
    // rebuilt at once; each further loss within 10 min waits 15 s more, at most 60 s (the death panel counts down).
    rebuild: (fee_per_rank: 150, per_death_secs: 15.0, window_secs: 600.0, max_secs: 60.0),
    warp_charge: 4.0,
    // Warp arrival (2026-10-25, spec warp_arrival): every ship used to appear on the warp point itself — two
    // arrivals stacked at 0 u and one ambush covered them all. Now from the side of the system it came from,
    // 650 u out, scattered 350 u, sliding in at 2× top speed and braking short of the warp point (Talon Lv1
    // 230 u/s → ~310 u, a cruiser ~400 u, a capital ~300 u), so ships from opposite sides do not meet in the middle.
    warp_arrive_dist: 650.0,
    warp_arrive_spread: 350.0,
    warp_arrive_speed: 2.0,
)
